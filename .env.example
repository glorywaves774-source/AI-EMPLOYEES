# Generate a long random secret and never commit real credentials.
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/ai_workforce
COOKIE_SECURE=false
FLASK_DEBUG=false

OPENAI_API_KEY=replace-with-your-secret-api-key
OPENAI_MODEL=gpt-5.5
REDIS_URL=redis://localhost:6379/0

# Team Coordinator execution limits. Cost budget is optional; set the model-specific
# input/output estimates below before enabling a non-zero cost budget.
TEAM_EXECUTION_TOKEN_BUDGET=12000
TEAM_EXECUTION_MAX_PARALLELISM=3
TEAM_EXECUTION_COST_BUDGET_USD=

# Generate two independent keys with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FILE_ENCRYPTION_KEY=replace-with-generated-fernet-key
INTEGRATION_ENCRYPTION_KEY=replace-with-a-different-generated-fernet-key

# Use local for development; use a private S3 bucket in production.
STORAGE_BACKEND=local
PRIVATE_UPLOAD_ROOT=./instance/knowledge-private
AWS_REGION=us-east-1
S3_BUCKET=

# Optional model-specific usage estimates; zero disables estimates.
ESTIMATED_INPUT_USD_PER_MILLION=0
ESTIMATED_OUTPUT_USD_PER_MILLION=0

# Milestone 8/9 — SaaS billing foundations
PLATFORM_NAME=Kayron Global Tech Services
BILLING_CURRENCY=GHS
PLAN_STARTER_AMOUNT=0
PLAN_GROWTH_AMOUNT=0
PLAN_BUSINESS_AMOUNT=0

# Configure only in production/staging secrets; never commit real values.
PAYSTACK_SECRET_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Milestone 10 security
MFA_ISSUER=AI Workforce
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
PASSWORD_RESET_MINUTES=30
EMAIL_VERIFICATION_HOURS=24
SECURITY_HEADERS_ENABLED=true
RATELIMIT_STORAGE_URI=memory://
PUBLIC_BASE_URL=http://localhost:5000
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM=

# Milestone 12 production hardening
ENVIRONMENT=development
TRUST_PROXY_COUNT=0
LOG_LEVEL=INFO
SECURITY_EVENT_RETENTION_DAYS=180
PLATFORM_ADMIN_LOGIN_MAX_ATTEMPTS=5
PLATFORM_ADMIN_LOCKOUT_MINUTES=15
PLATFORM_ADMIN_MFA_MAX_ATTEMPTS=5
PLATFORM_ADMIN_MFA_LOCKOUT_MINUTES=15
